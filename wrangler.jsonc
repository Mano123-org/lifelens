{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifelens",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-10",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lifelens",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}